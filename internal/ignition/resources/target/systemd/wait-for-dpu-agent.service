[Unit]
Description=Wait for dpu-agent configuration before kubelet
After=dpu-agent.service
Before=kubelet-dependencies.target
ConditionPathExists=/etc/mlnx-release
ConditionPathExists=/usr/local/bin/dpu-agent

[Service]
Type=oneshot
ExecStart=/usr/local/bin/wait-for-dpu-agent.sh
TimeoutStartSec=infinity

[Install]
RequiredBy=kubelet-dependencies.target
