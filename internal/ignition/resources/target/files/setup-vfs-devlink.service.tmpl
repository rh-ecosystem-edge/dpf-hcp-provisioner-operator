[Unit]
Description=Setup Host VFs and Activate devlink
After={{- if not .ZeroTrust }}tmfifo-agent-link.service {{ end }}devlink-activate.service
{{- if not .ZeroTrust }}
Requires=tmfifo-agent-link.service
{{- end }}
Before=install-dpu-agent.service
ConditionPathExists=!/etc/mlnx-release

[Service]
EnvironmentFile=/etc/dpf/environment
Type=oneshot
ExecStart=/usr/local/bin/setup-vfs-devlink.sh create-vfs
Restart=on-failure
RestartSec=30

[Install]
WantedBy=multi-user.target
