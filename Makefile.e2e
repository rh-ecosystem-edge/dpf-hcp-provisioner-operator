##@ E2E Testing
# See test/e2e/README.md for full documentation on setup, requirements, and usage.

E2E_TEST_TIMEOUT ?= 90m

# Run e2e tests on an existing OCP cluster.
# Required env vars:
#   MACHINE_OS_URL  - DPU machine OS image URL
#   BASE_DOMAIN     - cluster base domain for HostedCluster DNS
# In CI, IMAGE_DPF_HCP_PROVISIONER_OPERATOR_CI is injected automatically.
# For local testing, also set:
#   export KUBECONFIG=/path/to/kubeconfig
#   export IMAGE_DPF_HCP_PROVISIONER_OPERATOR_CI=quay.io/your-org/your-image:tag
.PHONY: test-e2e
test-e2e: ## Run e2e tests on an existing OCP cluster.
	E2E_SUITE_TIMEOUT=$(E2E_TEST_TIMEOUT) \
		cargo test -p e2e --test e2e_suite -- --ignored --nocapture

.PHONY: e2e-deploy-hypershift
e2e-deploy-hypershift: ## [E2E] Deploy HyperShift operator on the OCP management cluster.
	./test/e2e/scripts/deploy-hypershift.sh

# External CRDs are checked in (regenerate with `make generate-external-crds`):
#   test/e2e/testdata/crds  DPF provisioning/dpuservice/operator + OpenShift config/v1
#   config/crd/external     DPF provisioning/dpuservice + HyperShift
.PHONY: apply-crds-for-e2e
apply-crds-for-e2e: ## [E2E] Install the external CRDs on the cluster.
	$(KUBECTL) apply -f test/e2e/testdata/crds/
	$(KUBECTL) wait --for=condition=Established -f test/e2e/testdata/crds/ --timeout=60s

	@# Some of these are HyperShift CRDs which exceed the 256KB annotation limit, so use server-side apply
	$(KUBECTL) apply --server-side --force-conflicts -f config/crd/external/
	$(KUBECTL) wait --for=condition=Established -f config/crd/external/ --timeout=60s

E2E_KIND_TIMEOUT ?= 10m

.PHONY: test-e2e-kind
test-e2e-kind: manifests apply-crds-for-e2e ## Run kind-compatible e2e tests (no OCP required).
	KIND_ONLY_TESTS=true E2E_LABEL_FILTER='!ocp-required' \
		E2E_SUITE_TIMEOUT=$(E2E_KIND_TIMEOUT) \
		cargo test -p e2e --test e2e_suite -- --ignored --nocapture
