{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": [
        "github>konflux-ci/mintmaker-presets:refresh-rpm-lockfiles"
    ],
    "commitMessagePrefix": "NO-ISSUE: ",
    "labels": [
        "lgtm",
        "approved"
    ],
    "prHourlyLimit": 0,
    "prConcurrentLimit": 0,
    "enabledManagers": [
        "tekton",
        "rpm-lockfile",
        "dockerfile"
    ],
    "tekton": {
        "managerFilePatterns": [
            "/^.tekton/*/"
        ]
    },
    "lockFileMaintenance": {
        "enabled": true,
        "recreateWhen": "always",
        "schedule": [
            "at any time"
        ]
    },
    "packageRules": [
        {
            "groupName": "Konflux build pipeline",
            "addLabels": [
                "konflux"
            ],
            "schedule": [
                "on Saturday"
            ],
            "matchManagers": [
                "tekton"
            ]
        }
    ]
}